cabal-version:      2.4
name:               atom-simulator
version:            0.1.0.0
build-type:         Simple

common shared-extensions
  default-language:   GHC2024
  default-extensions: Strict,
                       TemplateHaskell,
                       TypeFamilies
  ghc-options:        -O2 -optc-w -Wmissing-signatures -Wmissing-local-signatures
  cc-options:         -w

library
  import:           shared-extensions
  hs-source-dirs:   src
  exposed-modules:  AtomSimulator.QuantumSolver,
                    AtomSimulator.OutputFormatter,
                    AtomSimulator.Units
  other-modules:    AtomSimulator.MathHelper
  build-depends:    base >=4 && <5,
                    array,
                    hmatrix,
                    units,
                    parallel

executable atom-simulator
  import:           shared-extensions
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:    base,
                    atom-simulator,
                    units,
                    open-browser
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"

test-suite atom-simulator-tests
  import:           shared-extensions
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          QuantumSolverTests.hs
  build-depends:    base,
                    atom-simulator,
                    hspec,
                    units,
                    array
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N" -fhpc
