cabal-version:      2.4
name:               atom-simulator
version:            0.1.0.0
build-type:         Simple

library
  hs-source-dirs:   src
  exposed-modules:  AtomSimulator.QuantumSolver,
                    AtomSimulator.Units
  other-modules:    AtomSimulator.MathHelper
  build-depends:    base >=4 && <5,
                    array,
                    hmatrix,
                    units

executable atom-simulator
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:    base,
                    atom-simulator,
                    units
